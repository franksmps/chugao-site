// OS temp helper scripts
_*.py
_*.js
_*.sh
_*.bat

// OS junk
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

// Python bytecode
__pycache__/
*.pyc

// Editor
.vscode/
.idea/
*.swp
*.swo

// Node
node_modules/
npm-debug.log

// Don't ignore images - they are part of the site
!images/

// Build artifact (regenerated by build_i18n.py)
i18n.json

// Keep translation data modules version-controlled (they match _*.py above but are real source)
!_blog_body_*.py
